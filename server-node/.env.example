# ─── MongoDB Atlas ───
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vaanitutor?retryWrites=true&w=majority

# ─── Auth / JWT ───
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRY=7d
INTERNAL_SERVICE_KEY=your-internal-service-key-shared-with-server-ai

# ─── URLs & Port ───
PORT=5000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ─── ZeptoMail (Zoho) ───
ZEPTOMAIL_SEND_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@vaanitutor.com
ZEPTOMAIL_FROM_NAME=VaaniTutor

# ─── Google OAuth ───
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Zoho OAuth ───
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/zoho/callback

# ─── Razorpay ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_AMOUNT_PAISE=29900
